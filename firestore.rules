rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Drafts: Authenticated users can read/write their own drafts
    match /drafts/{draftId} {
      // If draft document ID equals user UID:
      allow read, write: if request.auth != null && (
        request.auth.uid == draftId || resource.data.userId == request.auth.uid
      );
    }

    // Activity Logs: Public read/create, immutable logs
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

  }
}